<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks
      Condition="'$(NETCoreSdkVersion)' != '' and $([MSBuild]::VersionLessThan('$(NETCoreSdkVersion)', '10.0.100'))"
      >net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0-preview.2</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DotNativePluginEntry>SecureStoragePlugin</DotNativePluginEntry>
    <DotNativeSourceRoot Condition="'$(DotNativeSourceRoot)' == ''"
      >../dotNative</DotNativeSourceRoot>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="$(DotNativeSourceRoot)/src/DotNative/DotNative.csproj"
      Condition="Exists('$(DotNativeSourceRoot)/src/DotNative/DotNative.csproj')"
    />
    <PackageReference
      Include="DotNative"
      Version="0.1.0-preview.10"
      Condition="!Exists('$(DotNativeSourceRoot)/src/DotNative/DotNative.csproj')"
    />
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="../DotNative.Paths/DotNative.Paths.csproj"
      Condition="Exists('../DotNative.Paths/DotNative.Paths.csproj')"
    />
    <PackageReference
      Include="DotNative.Paths"
      Version="0.1.0-preview.1"
      Condition="!Exists('../DotNative.Paths/DotNative.Paths.csproj')"
    />
  </ItemGroup>
  <ItemGroup>
    <None Remove="LICENSE" />
    <None Include="LICENSE" Pack="true" PackagePath="LICENSE" />
    <None Remove="ORIGIN.md" />
    <None Include="ORIGIN.md" Pack="true" PackagePath="ORIGIN.md" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Platform/**/*;buildTransitive/**/*" />
    <None Include="Platform/**/*;buildTransitive/**/*" Pack="true" PackagePath="%(Identity)" />
  </ItemGroup>
  <Import Project="build/PluginAuthoring.props" />
  <Import Project="build/PluginAuthoring.targets" />
</Project>
